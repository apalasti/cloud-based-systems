# Attach a 10 GB EBS volume and mount it at /data for the app (uploads).
# Dockerrun.aws.json maps host /data -> container /data.
# When using RDS: EB injects RDS_* and the app builds DATABASE_URL from them; set UPLOAD_DIR=/data/uploads.

option_settings:
  aws:autoscaling:launchconfiguration:
    BlockDeviceMappings: "/dev/sdf=:5"

commands:
  01_create_data_dir:
    command: mkdir -p /data
    ignoreErrors: false
  02_format_and_mount:
    # On Nitro (AL2023) the extra EBS is usually /dev/nvme1n1. Format if new and mount.
    command: |
      DATA_DEV=$(ls /dev/nvme*n1 2>/dev/null | grep -v nvme0n1 | head -1)
      if [ -b "$DATA_DEV" ] && ! mountpoint -q /data; then
        [ -z "$(lsblk -n -o FSTYPE "$DATA_DEV" 2>/dev/null)" ] && mkfs -t ext4 "$DATA_DEV"
        mount "$DATA_DEV" /data
        grep -q "^$DATA_DEV /data " /etc/fstab || echo "$DATA_DEV /data ext4 defaults,nofail 0 2" >> /etc/fstab
      fi
    ignoreErrors: true
