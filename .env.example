SECRET_KEY=your-secret-key-change-in-production
# Local: postgresql://app:secret@localhost:5432/appdb (or run postgres via docker compose).
# Docker Compose sets DATABASE_URL (see docker-compose.yml).
DATABASE_URL=
# On Elastic Beanstalk with RDS attached, leave DATABASE_URL unset; the app builds it from:
# RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME, RDS_PASSWORD (injected by EB).
# RDS_HOSTNAME=
# RDS_PORT=5432
# RDS_DB_NAME=ebdb
# RDS_USERNAME=
# RDS_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=static/uploads
# Docker: UPLOAD_DIR=/data/uploads
LOG_LEVEL=INFO
